POSTGRES_USER=asset
POSTGRES_PASSWORD=asset_pass
POSTGRES_DB=asset_tracker
# 演示环境：本机 Docker 容器间 TCP 不通，app 使用 host 网络，直连宿主机 5432/6379。
DATABASE_URL=postgresql+psycopg://asset:asset_pass@127.0.0.1:5432/asset_tracker
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=demo-jwt-secret-change-me-in-prod-32b
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# 开发默认；生产务必更换（见 README 轮换步骤）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 二期：交易所 / 链上 / 行情。留空则自动走 mock fixtures，不会发真实请求。
BINANCE_API_KEY=
BINANCE_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BYBIT_API_KEY=
BYBIT_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
GATE_API_KEY=
GATE_API_SECRET=
ZERION_API_KEY=
ALCHEMY_API_KEY=
HELIUS_API_KEY=
COINGECKO_DEMO_API_KEY=
EVM_ADDRESSES=
SOLANA_ADDRESSES=
# 启动时把上面的地址幂等归属给该用户。留空等同 admin。其他用户没有钱包，链上同步走 mock。
WALLET_OWNER_USERNAME=
# 交易所 key 只绑该用户；其他用户（含 demo）一律走 mock，不会因为进程里有 key 就切到 live。
# 留空表示没有任何用户拥有这些 key。
EXCHANGE_OWNER_USERNAME=admin
SYNC_MODE=auto
SYNC_SINCE=2026-01-01
SYNC_INTERVAL_SECONDS=1800

# p36 冷却内同档 HF 恶化再告警：绝对降幅阈值（默认 0.10）；设为 0 关闭该判据。
ALERT_HF_ESCALATE_DELTA=0.10
# 相对降幅阈值，单位百分比（默认 8，即 8%）；设为 0 关闭该判据。
ALERT_HF_ESCALATE_PCT=8
# 数据源失败沿用旧 HF 时，有债且旧值处于 warn/danger 会另发 hf_stale 降级提醒（独立冷却，默认开启）。

# 三期·6 微信 ClawBot。TOKEN 留空即 mock，不发外网。bot token 只放这里，不入库。
WECHAT_BOT_TOKEN=
WECHAT_PUSH_MODE=auto
WECHAT_POLL_ENABLED=0

# iLink endpoint and scanned ids (env only; never commit values)
WECHAT_ILINK_BASEURL=
WECHAT_ILINK_USER_ID=
WECHAT_ILINK_BOT_ID=
